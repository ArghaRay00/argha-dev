---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";

Astro.response.status = 404;
---

<Layout title={`404 Not Found | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center text-center">
      <div class="font-mono text-sm text-foreground/40 mb-6">
        <pre class="text-left inline-block">
{`  _  _    ___  _  _
 | || |  / _ \\| || |
 | || |_| | | | || |_
 |__   _| | | |__   _|
    | | | |_| |  | |
    |_|  \\___/   |_|`}
        </pre>
      </div>

      <div class="card-glow p-6 max-w-md w-full text-left font-mono text-sm">
        <div class="flex items-center gap-2 mb-3 pb-3 border-b border-border">
          <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-green-500/80"></span>
          <span class="ml-2 text-foreground/40">terminal</span>
        </div>
        <p class="text-foreground/60">
          <span class="text-accent">$</span> curl argha.dev{Astro.url.pathname}
        </p>
        <p class="text-red-400 mt-1">
          error: page not found
        </p>
        <p class="text-foreground/40 mt-1">
          the page you're looking for doesn't exist,<br/>
          was moved, or was just a figment of the internet's imagination.
        </p>
        <p class="text-foreground/60 mt-3">
          <span class="text-accent">$</span> <span class="cursor-blink">_</span>
        </p>
      </div>

      <LinkButton
        href="/"
        class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-all hover:shadow-lg hover:shadow-accent/25 no-underline"
      >
        cd ~
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  .cursor-blink {
    animation: blink 1s step-end infinite;
  }
</style>
