---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- Hero -->
    <section id="hero" class="pt-12 pb-10 border-b border-border">
      <div class="flex items-center gap-3 mb-2">
        <span class="status-dot"></span>
        <span class="text-sm font-mono text-foreground/60">currently building <a href="https://github.com/golden-screen" class="text-accent link-hover" target="_blank">globo</a></span>
      </div>

      <h1 class="my-4 text-5xl font-bold sm:my-6 sm:text-7xl font-display tracking-tight">
        <span class="text-gradient">Argha Ray</span>
      </h1>

      <p class="text-lg text-foreground/80 max-w-xl leading-relaxed">
        Full-stack engineer, 9+ years. Enterprise systems at
        <strong class="text-foreground">Motorola Solutions</strong> by day,
        shipping side projects by night.
      </p>

      <div class="mt-6 flex items-center gap-4">
        <a
          href="/about/"
          class="inline-flex items-center gap-2 rounded-lg bg-accent px-4 py-2 text-sm font-medium text-white transition-all hover:shadow-lg hover:shadow-accent/25"
        >
          About me
          <IconArrowRight class="inline-block w-4 h-4 rtl:-rotate-180" />
        </a>
        <a
          target="_blank"
          href="/rss.xml"
          class="inline-flex items-center gap-2 rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground/70 transition-all hover:border-accent hover:text-accent"
          aria-label="rss feed"
          title="RSS Feed"
        >
          <IconRss width={16} height={16} class="stroke-current stroke-2" />
          RSS
        </a>
      </div>

      {
        SOCIALS.length > 0 && (
          <div class="mt-6 flex items-center gap-2">
            <Socials />
          </div>
        )
      }
    </section>

    <!-- Bento Grid -->
    <section class="pt-10 pb-8 border-b border-border">
      <div class="bento-grid">
        <!-- Work card -->
        <a href="/about/" class="card-glow p-5 block group">
          <div class="text-xs font-mono uppercase tracking-widest text-accent mb-3">Work</div>
          <h3 class="text-lg font-display font-semibold mb-1 group-hover:text-accent transition-colors">Motorola Solutions</h3>
          <p class="text-sm text-foreground/60 leading-relaxed">AuthZ service, deployer CLI, 666+ API tests, telecom platforms</p>
        </a>

        <!-- Projects card -->
        <a href="https://github.com/ArghaRay00" target="_blank" class="card-glow p-5 block group">
          <div class="text-xs font-mono uppercase tracking-widest text-accent mb-3">Projects</div>
          <h3 class="text-lg font-display font-semibold mb-1 group-hover:text-accent transition-colors">Open Source</h3>
          <p class="text-sm text-foreground/60 leading-relaxed">Globo (TVOD platform), OnlineExam (.NET 9), ArghaTrade, VastuDrishti</p>
        </a>

        <!-- Tech card -->
        <div class="card-glow p-5">
          <div class="text-xs font-mono uppercase tracking-widest text-accent mb-3">Stack</div>
          <div class="flex flex-wrap gap-2">
            {["Java", "C#", "TypeScript", "Go", "Spring", ".NET 9", "NestJS", "React", "Angular", "PostgreSQL", "AWS", "Docker"].map(tech => (
              <span class="rounded-md bg-muted px-2.5 py-1 text-xs font-medium text-foreground/80">{tech}</span>
            ))}
          </div>
        </div>

        <!-- Years card -->
        <div class="card-glow p-5 flex flex-col items-center justify-center text-center">
          <div class="text-5xl font-display font-bold text-gradient">9+</div>
          <div class="text-sm text-foreground/60 mt-1">years building software</div>
        </div>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentPosts.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-display font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6">
          <h2 class="text-2xl font-display font-semibold tracking-wide">Recent Posts</h2>
          <ul>
            {recentPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
