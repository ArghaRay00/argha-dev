---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SITE } from "@/config";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const allPosts = [...featuredPosts, ...recentPosts];
---

<Layout description="Argha Ray — software engineer at Motorola Solutions. Nine years in production backend systems. Building agent infrastructure and writing about what works.">
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <!-- Intro -->
    <section class="pt-12 pb-10">
      <h1 class="font-display font-medium text-foreground/90 mb-6 text-2xl sm:text-3xl tracking-tight leading-[1.2] max-w-2xl">
        Nine years of backend. Now teaching
        <span class="bg-gradient-to-r from-accent to-pink-500 bg-clip-text text-transparent font-semibold">agents to remember.</span>
      </h1>
      <p class="text-foreground/65 leading-relaxed max-w-xl text-base sm:text-lg">
        Software engineer at <strong class="text-foreground font-medium">Motorola Solutions</strong>, Bangalore.
        Java, C#, TypeScript, Python on the backend. On the side: tool orchestration, knowledge systems, and a
        <a href="https://vesper.argha.dev/chat" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline underline-offset-4">24/7 autonomous agent</a>
        with its own cognitive architecture.
      </p>
      {
        SOCIALS.length > 0 && (
          <div class="mt-4 flex items-center gap-2">
            <Socials />
          </div>
        )
      }
    </section>

    <!-- Posts -->
    {
      allPosts.length > 0 && (
        <section class="border-t border-border pt-8 pb-6">
          <h2 class="text-xs font-mono uppercase tracking-widest text-foreground/35 mb-8">Writing</h2>
          <ul>
            {allPosts.map(
              (data, index) =>
                index < SITE.postPerIndex && <Card variant="h3" {...data} />
            )}
          </ul>
        </section>
      )
    }

    {
      allPosts.length > SITE.postPerIndex && (
        <div class="my-8 text-center">
          <LinkButton href="/posts/">
            All Posts
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </div>
      )
    }
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
